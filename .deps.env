# Generated by the umbrella release.sh — do not hand-edit except to test an unreleased upstream
# locally (any git ref works: a tag, a branch, a SHA). The next release overwrites it.
#
# The upstream refs this botmaker-sdk release is built against.
# Consumer: jitpack.yml, which sources this file and injects these as
# -Dbotmaker.shared.version / -Dbotmaker.session.version / -Dbotmaker.studioapi.version /
# -Dbotmaker.plugintoolkit.version / -Dbotmaker.pluginbasics.version at build time.
#
# The committed poms keep botmaker.*.version at 0.0.0-SNAPSHOT (the reactor value), which no release
# build can resolve — so the refs live here, in the release commit itself. That makes the tag
# self-describing (checking it out tells you which upstreams it was cut with), and it is what replaced
# `git ls-remote --tags | sort -V | tail -1`: "newest tag" is only *usually* "the tag this release just
# cut". Pinning exactly is also what lets release.sh push shared, session and the sdk tags back to back —
# JitPack resolves and builds a pinned dependency tag on demand, so no link waits for the one before it.

SHARED_TAG=v0.0.20
SESSION_TAG=v0.0.12
STUDIO_API_TAG=v0.0.4
PLUGIN_TOOLKIT_TAG=v0.0.5
# Plugin #2, which owns the nine JDK value types this SDK's WireText delegates to. There is no release of
# it yet — the first `./release.sh --plugin-basics` writes a real tag here, and this SDK cannot be released
# before that happens, which is exactly what the plugin-basics -> sdk forcing edge says.
PLUGIN_BASICS_TAG=
