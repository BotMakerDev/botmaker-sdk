<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      THE PARENT (2026-11-26), as every plugin's. It gives what this pom said for itself until then: the contract's
      and the toolkit's versions (botmaker.studioapi.version, botmaker.plugintoolkit.version), JavaFX's, Java 25,
      UTF-8, compiler 3.11.0 with -parameters, flatten 1.4.1 keeping <properties> and <repositories>, the sources
      jar, and CHANGELOG.md and icon.png copied into the jar. Its version is a pin like the others below (doc 43).
    -->
    <parent>
        <groupId>com.github.BotMakerDev</groupId>
        <artifactId>botmaker-plugin-parent</artifactId>
        <version>0.6.3-SNAPSHOT</version>
        <relativePath>../botmaker-plugin-parent/pom.xml</relativePath>
    </parent>

    <groupId>com.github.BotMakerDev</groupId>
    <artifactId>botmaker-sdk</artifactId>
    <!-- Real: -SNAPSHOT on main, the release version on a tag; only the release moves it (umbrella
         docs/refactor/43-real-versions.md). -->
    <version>1.12.3-SNAPSHOT</version>
    <licenses>
        <license>
            <name>PolyForm-Noncommercial-1.0.0</name>
            <url>https://polyformproject.org/licenses/noncommercial/1.0.0</url>
        </license>
    </licenses>

    <!-- What Studio shows for this plugin: a plugin's name is its pom's <name> (2026-10-27). -->
    <name>BotMaker SDK</name>
    <!-- Said here, or the published pom would carry the parent's. -->
    <description>Plugin #1: the library a BotMaker bot runs on, and what Studio shows to make one.</description>

    <properties>
        <!-- The plugin class this jar is: the host reads it off the pom Maven copies into the jar, and this
             pom's groupId:artifactId is the plugin's identity. Literal, and kept by the parent's flatten. -->
        <botmaker.plugin>com.botmaker.sdk.plugin.SdkPlugin</botmaker.plugin>
        <!-- Stamped into the jar manifest (Build-Time) so a bot/editor can tell which SDK build it loaded;
             crucial for local dev where every rebuild reuses the same -SNAPSHOT jar file name. -->
        <maven.build.timestamp.format>yyyy-MM-dd'T'HH:mm:ss'Z'</maven.build.timestamp.format>
        <!-- botmaker-shared version. On main it is shared's main -SNAPSHOT, which resolves the sibling
             module in the umbrella reactor / a local install; the release commit sets the released version
             (doc 43), so a tag's pom names what it was built against.

             flatten-maven-plugin (the parent's) writes the literal version into the published pom. It was what made
             the old -D injection reach CONSUMERS: Maven installs and publishes the COMMITTED pom, not the
             effective one, and without flatten the published pom said botmaker-shared:${botmaker.shared.version}
             with the property at 0.0.0-SNAPSHOT, so every released SDK failed to resolve on any machine that
             had never built this repo locally. -->
        <botmaker.shared.version>0.10.2-SNAPSHOT</botmaker.shared.version>
        <!-- botmaker-session version. Same contract as botmaker.shared.version above. -->
        <botmaker.session.version>0.9.2-SNAPSHOT</botmaker.session.version>
        <!-- botmaker-plugin-basics version: PLUGIN #2, which owns the JDK value types and their editors.
             Same contract as the two above and the same
             flatten reason — it is an ordinary <dependencies> entry, so the published pom must carry a
             resolvable version, and cutting plugin-basics therefore forces an SDK release. -->
        <botmaker.pluginbasics.version>0.11.3-SNAPSHOT</botmaker.pluginbasics.version>
        <!-- botmaker-plugin-host version: ClasspathGrammar, which a running bot builds the value grammar with for
             its during-a-run parameters (Params.set, 2026-11-04). Same contract and flatten reason as the ones
             above; plugin-host's botmaker-java is `optional`, so it is declared below. -->
        <botmaker.pluginhost.version>0.14.3-SNAPSHOT</botmaker.pluginhost.version>
        <!-- botmaker-java version: the value grammar itself, and JDT with it. Same contract and flatten reason. -->
        <botmaker.java.version>0.4.3-SNAPSHOT</botmaker.java.version>
        <!-- JGraphT, the screen map's graph algorithms (internal.screens.MapGraph). -->
        <jgrapht.version>1.5.2</jgrapht.version>

        <!--
          The OCR stack's three versions move TOGETHER. Tess4J pins a lept4j, and lept4j's generated
          bindings target one exact Leptonica release; the JavaCPP natives below must be that release
          and the Tesseract that Tess4J was built against.

          tess4j 5.19.0 -> lept4j 1.24.0 -> Leptonica 1.87.0 (its Windows DLL is libleptonica1870.dll)
                        -> Tesseract 5.5.x            (its Windows DLL is libtesseract552.dll)

          Getting this wrong does NOT fail the build. It fails at the first OcrEngine.recognize() call,
          in a user's bot, as an undefined-symbol UnsatisfiedLinkError out of Leptonica1's static
          initialiser (measured: Leptonica 1.85.0 under lept4j 1.24.0 dies on pixFindBaselinesGen).
          OcrEngineNativeTest is the guard — it calls getWords(), the only path that reaches these
          bindings. When bumping Tess4J, read the new lept4j's bundled DLL name to find the Leptonica
          version to match, and check that org.bytedeco publishes it.

          This block and everything it pins moved here from botmaker-shared/pom.xml in SDK 1.2.0, with
          com.botmaker.shared.ocr -> com.botmaker.sdk.{api.vision,internal.ocr}. It is reproduced
          VERBATIM on purpose: the failure it describes is a user's, at runtime, and nothing in any
          build would have caught the paraphrase.
        -->
        <tess4j.version>5.19.0</tess4j.version>
        <bytedeco.tesseract.version>5.5.3-1.5.14</bytedeco.tesseract.version>
        <bytedeco.leptonica.version>1.87.0-1.5.14</bytedeco.leptonica.version>
        <!-- Tests tagged @Tag("slow") start a real browser (internal/web): left out by default, run by
             -Dgroups=slow -Dsurefire.excludedGroups= -->
        <surefire.excludedGroups>slow</surefire.excludedGroups>
    </properties>

    <repositories>
        <!-- JitPack: resolves com.github.BotMakerDev:botmaker-shared:<tag> when this SDK is built
             standalone against a released shared (the umbrella reactor resolves the SNAPSHOT locally
             instead, and JitPack's own build env injects this repo too). -->
        <repository>
            <id>jitpack.io</id>
            <url>https://jitpack.io</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- The screen map's graph algorithms (internal.screens.MapGraph, 2026-11-22); on Central, brings jheaps. -->
        <dependency>
            <groupId>org.jgrapht</groupId>
            <artifactId>jgrapht-core</artifactId>
            <version>${jgrapht.version}</version>
        </dependency>
        <!-- Shared cross-platform native window plumbing (enumerate / capture / focus / input).
             com.github.BotMakerDev coordinate + version property so this resolves from the umbrella
             reactor locally and from JitPack when published (see the property comment above). -->
        <dependency>
            <groupId>com.github.BotMakerDev</groupId>
            <artifactId>botmaker-shared</artifactId>
            <version>${botmaker.shared.version}</version>
        </dependency>

        <!-- Private display sessions (com.botmaker.session.*): the nested :N display a bot isolates into,
             reached from Target.start() via internal.session.SessionBootstrap. Same coordinate/property
             contract as shared above. It depends on shared itself, so this is additive, not a replacement. -->
        <dependency>
            <groupId>com.github.BotMakerDev</groupId>
            <artifactId>botmaker-session</artifactId>
            <version>${botmaker.session.version}</version>
        </dependency>

        <!-- The value grammar and JDT, in every bot (the user's call, 2026-11-04, about 10 MB): any run keeps what
             it learned, in Studio, `botmaker plugin run` or plain `java`. -->
        <dependency>
            <groupId>com.github.BotMakerDev</groupId>
            <artifactId>botmaker-plugin-host</artifactId>
            <version>${botmaker.pluginhost.version}</version>
        </dependency>
        <dependency>
            <groupId>com.github.BotMakerDev</groupId>
            <artifactId>botmaker-java</artifactId>
            <version>${botmaker.java.version}</version>
        </dependency>

        <!-- The Studio plugin contract, at `compile`: a bot's own code carries @Param and @Managed, so it
             needs the contract jar to compile. PluginLoader is parent-first for com.botmaker.plugin.api.**,
             so a plugin still links the host's copy. Nothing may declare the contract directly beside this
             SDK in a bot's pom (nearest-wins would pin a version this jar was not built against). -->

        <dependency>
            <groupId>com.github.BotMakerDev</groupId>
            <artifactId>botmaker-studio-api</artifactId>
        </dependency>

        <!-- The plugin toolkit, at plain `compile` and never `optional`: PluginLoader is child-first for it,
             so a plugin brings its own, and `optional` (not transitive) would leave SdkPlugin unloadable in a
             project that adds the SDK. It has no dependencies, so a bot pays only its own jar. -->
        <dependency>
            <groupId>com.github.BotMakerDev</groupId>
            <artifactId>botmaker-plugin-toolkit</artifactId>
        </dependency>

        <!-- Plugin #2 (the JDK value types and their editors), at `compile`: an ordinary plugin-to-plugin
             dependency, so a project with the SDK can edit a String or a Duration. No SDK code names it since
             2026-09-28 (the @Managed runtime is the contract's); in a bot it is one inert jar. Nothing may
             declare it directly beside this SDK in a bot's pom (nearest-wins). -->
        <dependency>
            <groupId>com.github.BotMakerDev</groupId>
            <artifactId>botmaker-plugin-basics</artifactId>
            <version>${botmaker.pluginbasics.version}</version>
        </dependency>

        <!-- JavaFX, Javalin and ZXing are `optional`: only the plugin half (Studio-side) links them, and a
             headless bot must resolve none of them. javafx.* is parent-first, so the host supplies it.
             The two JavaFX artifacts move together (javafx.version, the parent's). `compile` is said because the
             parent manages javafx-controls as `provided`, which this pom has never published. -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <scope>compile</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-graphics</artifactId>
            <version>${javafx.version}</version>
            <optional>true</optional>
        </dependency>

        <!-- ZXing core: the connect-a-phone window's QR codes, drawn straight into a JavaFX WritableImage. -->
        <dependency>
            <groupId>com.google.zxing</groupId>
            <artifactId>core</artifactId>
            <version>3.5.3</version>
            <optional>true</optional>
        </dependency>

        <!-- JavaCV / OpenCV (native bindings used for image matching) -->
        <dependency>
            <groupId>org.openpnp</groupId>
            <artifactId>opencv</artifactId>
            <version>4.9.0-0</version>
        </dependency>

        <!-- Tess4J: Tesseract behind internal.ocr and api.vision.Text. Windows natives are bundled; Linux
             ones are staged by <build>. Pinned together with lept4j/bytedeco — see <properties>. -->
        <dependency>
            <groupId>net.sourceforge.tess4j</groupId>
            <artifactId>tess4j</artifactId>
            <version>${tess4j.version}</version>
        </dependency>

        <!-- JNA (native Windows/Linux window + input control) -->
        <dependency>
            <groupId>net.java.dev.jna</groupId>
            <artifactId>jna</artifactId>
            <version>5.14.0</version>
        </dependency>
        <dependency>
            <groupId>net.java.dev.jna</groupId>
            <artifactId>jna-platform</artifactId>
            <version>5.14.0</version>
        </dependency>

        <!-- Jackson Databind (config serialization) -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.17.0</version>
        </dependency>

        <!-- Markdown read as a tree, not by line: the bot's GAME.md, edited a section at a time by the assistant
             (its source spans). Studio draws the same file with the same version. -->
        <dependency>
            <groupId>org.commonmark</groupId>
            <artifactId>commonmark</artifactId>
            <version>0.21.0</version>
        </dependency>

        <!-- ELK's layered layout: 🗺 Screens lays the map out by it (plugin.map.ElkLayout). At `compile`, so every
             bot carries it with EMF and Guava, about 8.4 MB: the user's call (2026-10-22), over the toolkit's own
             layout. The toolkit itself stays without it. -->
        <dependency>
            <groupId>org.eclipse.elk</groupId>
            <artifactId>org.eclipse.elk.alg.layered</artifactId>
            <version>0.12.0</version>
        </dependency>
        <!-- The map's other layout modes (plugin.map.LayoutMode): a tree, a hub, the stress layout (shipped in the
             force artifact), and disco, which packs the parts of a map no way joins. -->
        <dependency>
            <groupId>org.eclipse.elk</groupId>
            <artifactId>org.eclipse.elk.alg.mrtree</artifactId>
            <version>0.12.0</version>
        </dependency>
        <dependency>
            <groupId>org.eclipse.elk</groupId>
            <artifactId>org.eclipse.elk.alg.radial</artifactId>
            <version>0.12.0</version>
        </dependency>
        <dependency>
            <groupId>org.eclipse.elk</groupId>
            <artifactId>org.eclipse.elk.alg.force</artifactId>
            <version>0.12.0</version>
        </dependency>
        <dependency>
            <groupId>org.eclipse.elk</groupId>
            <artifactId>org.eclipse.elk.alg.disco</artifactId>
            <version>0.12.0</version>
        </dependency>
        <!-- Xbase's runtime library, which ELK's classes call and its poms leave out (its OSGi manifest asks for the
             bundle instead): without it ELK's options fail to load. -->
        <dependency>
            <groupId>org.eclipse.xtext</groupId>
            <artifactId>org.eclipse.xtext.xbase.lib</artifactId>
            <version>2.44.0</version>
        </dependency>
        <!-- Guava pinned: ELK's graph asks for the range [15.0,), which Maven resolves to whatever is newest the day a
             build runs, and offline to whichever ~/.m2 happens to hold. -->
        <dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
            <version>33.7.2-jre</version>
        </dependency>

        <!-- Test Dependencies -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <version>1.10.2</version>
            <scope>test</scope>
        </dependency>

        <!-- ClassGraph, test only: ApiCatalogTest and PaletteFillabilityTest scan target/classes. Same
             version as Studio, which scans a resolved SDK jar the same way. -->
        <dependency>
            <groupId>io.github.classgraph</groupId>
            <artifactId>classgraph</artifactId>
            <version>4.8.179</version>
            <scope>test</scope>
        </dependency>

        <!-- TestFX on Monocle's headless platform, test only: a window's bar laid out and read with no display
             (ScreenMapBarTest). The versions Studio's pom pins, Monocle 21.0.2 included. -->
        <dependency>
            <groupId>org.testfx</groupId>
            <artifactId>testfx-core</artifactId>
            <version>4.0.18</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testfx</groupId>
            <artifactId>testfx-junit5</artifactId>
            <version>4.0.18</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testfx</groupId>
            <artifactId>openjfx-monocle</artifactId>
            <version>21.0.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- No <resources> block: Maven's default (src/main/resources) is what this module wants.

             There was one for a day, copying com/botmaker/sdk/internal/plugin/seeds/*.java into the jar so a
             host could read a seed's TEXT back out with getResourceAsStream. The seeds are deleted and so is
             the surface that read them — a plugin does not write files into a user's project. Declaring
             <resources> at all switches off the default and means re-declaring it, so leaving the block out
             is not merely tidier: it is one less thing that silently drops src/main/resources if edited
             carelessly. -->
        <plugins>
            <!-- Maven Compiler Plugin — no annotation processor at all, since 2026-08-27.

                 There were two passes, then one, and now none. src/apt/java held ApiPointerProcessor and
                 PaletteCatalogProcessor; both moved into botmaker-plugin-processor as one
                 PluginSurfaceProcessor named here in <annotationProcessorPaths>; and then the catalog stopped
                 being generated. SdkPlugin builds it with PaletteCatalog.of(...) instead, reflecting the
                 facades at load time.

                 The property the generator was defended on — "a catalog naming a renamed member does not
                 compile" — does not need saving, because members are now DISCOVERED rather than named:
                 @Hidden, @PaletteDefault and @PaletteLabel travel with the member they annotate, so there is
                 nothing left to go stale. What stays javac-checked is the class list, which is written as
                 class literals in SdkPlugin.

                 It also cost something a third-party plugin could not pay: a pom that omitted this block got
                 no catalog and nothing said why. Reflection needs no build configuration to be right. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <!-- Version and -parameters are the parent's: Studio reads real parameter names from the
                     resolved SDK jar to label call arguments (findCompare(good, bad), not arg0/arg1). -->
                <configuration>
                    <proc>none</proc>
                </configuration>
            </plugin>

            <!--
              Stage the Linux OCR natives into the jar, under JNA's Platform.RESOURCE_PREFIX for this
              platform (linux-x86-64). Tess4J's LoadLibs static initialiser extracts every classpath
              resource under that prefix to a temp dir and prepends it to jna.library.path — the same
              mechanism that already makes Windows self-contained through win32-x86-64/. So this needs
              no Java code: put the files on the classpath and Tess4J finds them.

              WHY WE SHIP THEM AT ALL: Tess4J publishes Windows DLLs only. On Linux it dlopen()s the
              system libtesseract, so OCR failed with UnsatisfiedLinkError anywhere it wasn't installed —
              the AppImage, the tarball and every generated bot, none of which have a package manager to
              declare a dependency to.

              WHY THE JAVACPP PRESETS: Fedora's libtesseract links libcurl, so its ldd closure is 46
              libraries / 29 MB (openssl, krb5, ldap, sasl, ssh — none of which OCR uses). The bytedeco
              build needs only libleptonica.so.6, libstdc++, libm, libgcc_s and libc, with the image
              codecs statically linked in, and carries RUNPATH $ORIGIN/ so tesseract finds leptonica
              beside itself. Two files, 9.4 MB, no other system library beyond what a JVM already needs.

              THE TWO FILENAMES ARE LOAD-BEARING, both established by testing:
                - Tesseract is renamed to the UNVERSIONED libtesseract.so. Left as libtesseract.so.5.5,
                  JNA's lookup skipped it and loaded the system /usr/lib64 copy instead, which silently
                  defeats the whole point on any machine that has one.
                - Leptonica KEEPS libleptonica.so.6, because that is the literal NEEDED string inside
                  libtesseract.so. Adding an unversioned copy alongside it makes the process map
                  leptonica twice.

              The bytedeco jars also carry headers and .a files (~2 MB); the includes below drop them.

              MACOS (Apple Silicon only, as Studio's .dmg): the same two libraries from the macosx-arm64
              classifier, staged under darwin-aarch64/, JNA's prefix there. Three files, because macOS JNA
              does no versioned-name matching (Linux's finds libleptonica.so.6 for "leptonica"; macOS's only
              ever asks for the exact libleptonica.dylib):
                - Tesseract is renamed to libtesseract.dylib, for the same reason as on Linux.
                - Leptonica is staged as libleptonica.6.dylib, the literal @rpath name libtesseract links
                  (its rpath is @loader_path/, so beside it), AND as libleptonica.dylib, the name lept4j asks
                  for. dyld may map the two copies separately; they share malloc and the Pix layout, so a Pix
                  made by one and read by the other is the same struct. Renaming a dylib's dependency instead
                  would need install_name_tool and break its code signature on arm64.
              Intel Macs get no OCR natives: Studio ships no Intel build either.

              This moved here from botmaker-shared/pom.xml in SDK 1.2.0, unchanged apart from living
              beside the code it serves. The staging half is the maven-antrun execution below.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.6.1</version>
                <executions>
                    <execution>
                        <id>unpack-linux-ocr-natives</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>unpack</goal>
                        </goals>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>org.bytedeco</groupId>
                                    <artifactId>tesseract</artifactId>
                                    <version>${bytedeco.tesseract.version}</version>
                                    <classifier>linux-x86_64</classifier>
                                    <includes>**/libtesseract.so.*</includes>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>org.bytedeco</groupId>
                                    <artifactId>leptonica</artifactId>
                                    <version>${bytedeco.leptonica.version}</version>
                                    <classifier>linux-x86_64</classifier>
                                    <includes>**/libleptonica.so.*</includes>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>org.bytedeco</groupId>
                                    <artifactId>tesseract</artifactId>
                                    <version>${bytedeco.tesseract.version}</version>
                                    <classifier>macosx-arm64</classifier>
                                    <includes>**/libtesseract.*.dylib</includes>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>org.bytedeco</groupId>
                                    <artifactId>leptonica</artifactId>
                                    <version>${bytedeco.leptonica.version}</version>
                                    <classifier>macosx-arm64</classifier>
                                    <includes>**/libleptonica.*.dylib</includes>
                                </artifactItem>
                            </artifactItems>
                            <outputDirectory>${project.build.directory}/native-stage</outputDirectory>
                            <overWriteReleases>false</overWriteReleases>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Antrun: `stage-linux-ocr-natives` finishes the OCR native staging the dependency plugin above
                 started. It runs beside the parent's `plugin-files`, which copies the changelog and the icon. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>stage-linux-ocr-natives</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <property name="ocr.natives.dir"
                                          value="${project.build.outputDirectory}/linux-x86-64"/>
                                <mkdir dir="${ocr.natives.dir}"/>
                                <!-- Flattened and renamed: see the filename note above. -->
                                <copy todir="${ocr.natives.dir}" flatten="true" failonerror="true">
                                    <fileset dir="${project.build.directory}/native-stage"
                                             includes="**/libtesseract.so.*"/>
                                    <mapper type="merge" to="libtesseract.so"/>
                                </copy>
                                <copy todir="${ocr.natives.dir}" flatten="true" failonerror="true">
                                    <fileset dir="${project.build.directory}/native-stage"
                                             includes="**/libleptonica.so.*"/>
                                </copy>
                                <!-- macOS: renamed and doubled, see the macOS note above. -->
                                <property name="ocr.natives.mac.dir"
                                          value="${project.build.outputDirectory}/darwin-aarch64"/>
                                <mkdir dir="${ocr.natives.mac.dir}"/>
                                <copy todir="${ocr.natives.mac.dir}" flatten="true" failonerror="true">
                                    <fileset dir="${project.build.directory}/native-stage"
                                             includes="**/macosx-arm64/libtesseract.*.dylib"/>
                                    <mapper type="merge" to="libtesseract.dylib"/>
                                </copy>
                                <copy todir="${ocr.natives.mac.dir}" flatten="true" failonerror="true">
                                    <fileset dir="${project.build.directory}/native-stage"
                                             includes="**/macosx-arm64/libleptonica.*.dylib"/>
                                </copy>
                                <copy todir="${ocr.natives.mac.dir}" flatten="true" failonerror="true">
                                    <fileset dir="${project.build.directory}/native-stage"
                                             includes="**/macosx-arm64/libleptonica.*.dylib"/>
                                    <mapper type="merge" to="libleptonica.dylib"/>
                                </copy>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Jar Plugin: stamp the manifest with Implementation-* (pom version/vendor) and a Build-Time
                 so a running bot / Studio's editor can report exactly which SDK build was loaded. A local
                 build carries the pom's main -SNAPSHOT every time, so Build-Time is the signal that
                 distinguishes local rebuilds sharing one jar file name. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <archive>
                        <manifest>
                            <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
                        </manifest>
                        <manifestEntries>
                            <Build-Time>${maven.build.timestamp}</Build-Time>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.jetbrains.dokka</groupId>
                <artifactId>dokka-maven-plugin</artifactId>
                <version>1.9.20</version> <!-- Latest stable 1.9.x version -->
                <executions>
                    <execution>
                        <phase>pre-site</phase>
                        <goals>
                            <goal>dokka</goal> <!-- 'dokka' generates the modern HTML UI -->
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <sourceDirectories>
                        <dir>${project.basedir}/src/main/java</dir>
                    </sourceDirectories>

                    <!-- Optional: Add a custom home page (like a Swagger overview) -->
                    <!--
                    <includes>
                        <include>${project.basedir}/README.md</include>
                    </includes>
                    -->
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
