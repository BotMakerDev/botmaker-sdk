<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.github.LiQiyeDev</groupId>
    <artifactId>botmaker-sdk</artifactId>
    <version>0.0.0-SNAPSHOT</version>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Stamped into the jar manifest (Build-Time) so a bot/editor can tell which SDK build it loaded;
             crucial for local dev where every rebuild reuses the same 0.0.0-SNAPSHOT jar file name. -->
        <maven.build.timestamp.format>yyyy-MM-dd'T'HH:mm:ss'Z'</maven.build.timestamp.format>
        <!-- botmaker-shared version. Committed value is ALWAYS 0.0.0-SNAPSHOT: it resolves the sibling
             module in the umbrella reactor / dev-install. The real released shared tag is injected only at
             build time by CI (jitpack.yml) via -Dbotmaker.shared.version=<tag> — never committed here, so a
             clean checkout matches the reactor/dev value and there is no stale pin to get out of sync.

             That injection only reaches CONSUMERS because of flatten-maven-plugin below. Maven installs and
             publishes the COMMITTED pom, not the effective one, so a -D on the command line changes what
             this build resolves and nothing about what a bot resolving this SDK from JitPack sees. Without
             flatten, the published pom still said botmaker-shared:${botmaker.shared.version} with the
             property at 0.0.0-SNAPSHOT, and every released SDK failed to resolve on any machine that had
             never built this repo locally. Do not remove the plugin without replacing the mechanism. -->
        <botmaker.shared.version>0.0.0-SNAPSHOT</botmaker.shared.version>
        <!-- botmaker-session version. Same contract as botmaker.shared.version above: always 0.0.0-SNAPSHOT
             in the committed pom, injected at build time by CI for a released tag, resolved into the
             published pom by flatten. -->
        <botmaker.session.version>0.0.0-SNAPSHOT</botmaker.session.version>
        <!-- botmaker-studio-api version: the Studio plugin contract. Same 0.0.0-SNAPSHOT contract again.
             This one moves far more slowly than the other two on purpose — see the dependency below. -->
        <botmaker.studioapi.version>0.0.0-SNAPSHOT</botmaker.studioapi.version>
        <!-- botmaker-plugin-processor version: the annotation processor that writes this module's palette
             catalog and enforces the surface rules. Same 0.0.0-SNAPSHOT contract, with one difference worth
             knowing — it is named in <annotationProcessorPaths>, never in <dependencies>, so it is on the
             processor path at compile time and on nobody's classpath ever. It therefore does not appear in
             the flattened pom at all, and a consumer of this jar never resolves it. -->
        <botmaker.pluginprocessor.version>0.0.0-SNAPSHOT</botmaker.pluginprocessor.version>
        <!-- botmaker-plugin-toolkit version: the widgets this module's slot editors are built from. Same
             0.0.0-SNAPSHOT contract as the three above, and the same flatten reason — it IS in
             <dependencies>, so the published pom must carry a resolvable version. Optional there, exactly
             like the contract: a bot never links an editor. -->
        <botmaker.plugintoolkit.version>0.0.0-SNAPSHOT</botmaker.plugintoolkit.version>
        <!-- JavaFX, for the slot editors only. Held in one place because the two artifacts must move
             together — javafx-controls is compiled against one exact javafx-graphics. -->
        <javafx.version>21</javafx.version>

        <!--
          The OCR stack's three versions move TOGETHER. Tess4J pins a lept4j, and lept4j's generated
          bindings target one exact Leptonica release; the JavaCPP natives below must be that release
          and the Tesseract that Tess4J was built against.

          tess4j 5.19.0 -> lept4j 1.24.0 -> Leptonica 1.87.0 (its Windows DLL is libleptonica1870.dll)
                        -> Tesseract 5.5.x            (its Windows DLL is libtesseract552.dll)

          Getting this wrong does NOT fail the build. It fails at the first OcrEngine.recognize() call,
          in a user's bot, as an undefined-symbol UnsatisfiedLinkError out of Leptonica1's static
          initialiser (measured: Leptonica 1.85.0 under lept4j 1.24.0 dies on pixFindBaselinesGen).
          OcrEngineNativeTest is the guard — it calls getWords(), the only path that reaches these
          bindings. When bumping Tess4J, read the new lept4j's bundled DLL name to find the Leptonica
          version to match, and check that org.bytedeco publishes it.

          This block and everything it pins moved here from botmaker-shared/pom.xml in SDK 1.2.0, with
          com.botmaker.shared.ocr -> com.botmaker.sdk.{api.vision,internal.ocr}. It is reproduced
          VERBATIM on purpose: the failure it describes is a user's, at runtime, and nothing in any
          build would have caught the paraphrase.
        -->
        <tess4j.version>5.19.0</tess4j.version>
        <bytedeco.tesseract.version>5.5.3-1.5.14</bytedeco.tesseract.version>
        <bytedeco.leptonica.version>1.87.0-1.5.14</bytedeco.leptonica.version>
    </properties>

    <repositories>
        <!-- JitPack: resolves com.github.LiQiyeDev:botmaker-shared:<tag> when this SDK is built
             standalone against a released shared (the umbrella reactor resolves the SNAPSHOT locally
             instead, and JitPack's own build env injects this repo too). -->
        <repository>
            <id>jitpack.io</id>
            <url>https://jitpack.io</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- Shared cross-platform native window plumbing (enumerate / capture / focus / input).
             com.github.LiQiyeDev coordinate + version property so this resolves from the umbrella
             reactor locally and from JitPack when published (see the property comment above). -->
        <dependency>
            <groupId>com.github.LiQiyeDev</groupId>
            <artifactId>botmaker-shared</artifactId>
            <version>${botmaker.shared.version}</version>
        </dependency>

        <!-- Private display sessions (com.botmaker.session.*): the nested :N display a bot isolates into,
             reached from Target.start() via internal.session.SessionBootstrap. Same coordinate/property
             contract as shared above. It depends on shared itself, so this is additive, not a replacement. -->
        <dependency>
            <groupId>com.github.LiQiyeDev</groupId>
            <artifactId>botmaker-session</artifactId>
            <version>${botmaker.session.version}</version>
        </dependency>

        <!-- The Studio plugin contract. This SDK is Studio's plugin #1 — a privileged default plugin, but a
             plugin: it contributes its own palette catalog and its own value-slot editors through this
             contract rather than through a back door. See ../docs/refactor/24-plugin-platform.md.

             <optional>true</optional> is what keeps it off a generated bot's classpath. A bot compiles
             against api.* and never names a plugin type; the classes in this jar that DO implement the
             contract (under internal.plugin) are simply never linked in a bot's JVM, exactly as an SLF4J
             binding is never linked by code that only calls the logger. Nothing under com.botmaker.sdk.api
             may reference a com.botmaker.plugin.api type — that is what makes the optional dependency safe
             rather than a NoClassDefFoundError waiting for its first caller. -->
        <dependency>
            <groupId>com.github.LiQiyeDev</groupId>
            <artifactId>botmaker-studio-api</artifactId>
            <version>${botmaker.studioapi.version}</version>
            <optional>true</optional>
        </dependency>

        <!-- The plugin widget toolkit, and JavaFX under it: what internal.plugin.editors is built from.

             All three are <optional>true</optional> for exactly the reason the contract above is. A bot
             compiles against api.* and never names an editor; the editor classes are in this jar and are
             simply never linked in a bot's JVM. A generated bot must NOT drag JavaFX onto its classpath —
             it is a headless program, and on a machine with no JavaFX distribution for its platform the
             resolve would fail outright.

             The toolkit is the plugin's own dependency and never the host's: botmaker-studio must not list
             it, or two plugins can no longer hold two versions of it. See ../CLAUDE.md. -->
        <dependency>
            <groupId>com.github.LiQiyeDev</groupId>
            <artifactId>botmaker-plugin-toolkit</artifactId>
            <version>${botmaker.plugintoolkit.version}</version>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-graphics</artifactId>
            <version>${javafx.version}</version>
            <optional>true</optional>
        </dependency>

        <!-- JavaCV / OpenCV (native bindings used for image matching) -->
        <dependency>
            <groupId>org.openpnp</groupId>
            <artifactId>opencv</artifactId>
            <version>4.9.0-0</version>
        </dependency>

        <!-- Tess4J: the JNA wrapper over Tesseract, behind internal.ocr.OcrEngine and the api.vision.Text
             facade. It bundles the Windows natives; the Linux ones are staged into this jar by <build>
             below. It lived in botmaker-shared until SDK 1.2.0, where it made every consumer of shared —
             Studio and botmaker-session included — resolve an OCR engine none of them ever called. Pulls
             JNA, already present below. See the version-pinning note in <properties>. -->
        <dependency>
            <groupId>net.sourceforge.tess4j</groupId>
            <artifactId>tess4j</artifactId>
            <version>${tess4j.version}</version>
        </dependency>

        <!-- JNA (native Windows/Linux window + input control) -->
        <dependency>
            <groupId>net.java.dev.jna</groupId>
            <artifactId>jna</artifactId>
            <version>5.14.0</version>
        </dependency>
        <dependency>
            <groupId>net.java.dev.jna</groupId>
            <artifactId>jna-platform</artifactId>
            <version>5.14.0</version>
        </dependency>

        <!-- Jackson Databind (config serialization) -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.17.0</version>
        </dependency>

        <!-- There is deliberately no maven-model here (2026-08-26, a one-day reversal). The SDK does not
             write a generated bot's pom.xml: the pom is what *names* the SDK, and — the maintainer's
             framing — the SDK is only the default plugin of the editor. A plugin cannot enumerate its
             siblings, so a pom it wrote would silently omit every other plugin's dependency. The editor
             composes it; see Authoring.createProject's `callerFiles`. -->

        <!-- The Android-emulator transport (dadb) lives in botmaker-shared now, so it arrives transitively
             via the shared dependency above — the SDK's api.emulator facade compiles against
             com.botmaker.shared.emulator.{AdbDevice, Platforms, EmulatorInstance}. -->

        <!-- Test Dependencies -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <version>1.10.2</version>
            <scope>test</scope>
        </dependency>

        <!-- ClassGraph, TEST SCOPE ONLY — it must never reach a bot's classpath; this is a library a bot
             compiles against, not an application. It exists here for ApiPointersTest, which reads the
             @ReplacedBy / @Replaces pointers straight out of this build's own target/classes and refuses a
             link that is incomplete. Same version Studio pins, deliberately: Studio reads the very same
             annotations out of a resolved SDK jar at upgrade time, so the gate and the consumer agree on
             how a CLASS-retention annotation is parsed rather than agreeing by coincidence. -->
        <dependency>
            <groupId>io.github.classgraph</groupId>
            <artifactId>classgraph</artifactId>
            <version>4.8.179</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Maven Compiler Plugin — ONE pass, since 2026-08-27.

                 It used to be two. src/apt/java held ApiPointerProcessor and PaletteCatalogProcessor, and a
                 compile-processor execution at process-sources built them into target/apt-classes with
                 -proc:none so the main compile could name them on a -processorpath. The comment that stood
                 here said why annotationProcessorPaths could not express it: "it takes artifact coordinates,
                 not a directory of a module's own making".

                 So the processor became an artifact. Both classes now live in botmaker-plugin-processor as
                 one PluginSurfaceProcessor, because a second plugin wanting a catalog would otherwise have
                 had to re-derive 680 lines of build machinery — a back door the plugin platform exists to
                 close, hidden in the one place nobody looks, since a processor is build machinery rather
                 than a type.

                 annotationProcessorPaths (not <dependencies>) is what keeps it off the compile classpath:
                 nothing in src/main/java may name a processor class, and nothing does. The two -A options
                 are the whole of this module's configuration of it — where to write the catalog, and which
                 package roots it is answering for. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <!-- Emit the MethodParameters attribute so real parameter names survive in the
                         bytecode. Studio (which does NOT depend on the SDK) reads them from the resolved
                         SDK jar via ClassGraph to label call arguments (e.g. findCompare(good, bad))
                         instead of arg0/arg1. -->
                    <parameters>true</parameters>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>com.github.LiQiyeDev</groupId>
                            <artifactId>botmaker-plugin-processor</artifactId>
                            <version>${botmaker.pluginprocessor.version}</version>
                        </path>
                    </annotationProcessorPaths>
                    <compilerArgs>
                        <!-- Where the generated palette catalog lands. Without it the processor derives a
                             package from the facades' common prefix and says so in a NOTE; naming it is
                             better, because SdkPlugin imports it. -->
                        <arg>-Abotmaker.catalog=com.botmaker.sdk.internal.plugin.catalog.Catalog</arg>
                        <!-- The roots this module answers for. Every top-level class under them must carry
                             @Facade or @Internal, directly or by package-info, and the pointer rules read
                             the same set. Absent, both checks are simply off. -->
                        <arg>-Abotmaker.surface=com.botmaker.sdk</arg>
                    </compilerArgs>
                </configuration>
                <executions>
                    <execution>
                        <!-- No processing over src/test/java. A test lives in the package it tests, so
                             every one of them is "under com.botmaker.sdk" and the completeness gate would
                             demand each be classified as surface or plumbing — a question that does not
                             apply: a test is neither, and it ships in no jar. Turning the processor off is
                             the honest answer, and it is also faster. -->
                        <id>default-testCompile</id>
                        <configuration>
                            <proc>none</proc>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!--
              Stage the Linux OCR natives into the jar, under JNA's Platform.RESOURCE_PREFIX for this
              platform (linux-x86-64). Tess4J's LoadLibs static initialiser extracts every classpath
              resource under that prefix to a temp dir and prepends it to jna.library.path — the same
              mechanism that already makes Windows self-contained through win32-x86-64/. So this needs
              no Java code: put the files on the classpath and Tess4J finds them.

              WHY WE SHIP THEM AT ALL: Tess4J publishes Windows DLLs only. On Linux it dlopen()s the
              system libtesseract, so OCR failed with UnsatisfiedLinkError anywhere it wasn't installed —
              the AppImage, the tarball and every generated bot, none of which have a package manager to
              declare a dependency to.

              WHY THE JAVACPP PRESETS: Fedora's libtesseract links libcurl, so its ldd closure is 46
              libraries / 29 MB (openssl, krb5, ldap, sasl, ssh — none of which OCR uses). The bytedeco
              build needs only libleptonica.so.6, libstdc++, libm, libgcc_s and libc, with the image
              codecs statically linked in, and carries RUNPATH $ORIGIN/ so tesseract finds leptonica
              beside itself. Two files, 9.4 MB, no other system library beyond what a JVM already needs.

              THE TWO FILENAMES ARE LOAD-BEARING, both established by testing:
                - Tesseract is renamed to the UNVERSIONED libtesseract.so. Left as libtesseract.so.5.5,
                  JNA's lookup skipped it and loaded the system /usr/lib64 copy instead, which silently
                  defeats the whole point on any machine that has one.
                - Leptonica KEEPS libleptonica.so.6, because that is the literal NEEDED string inside
                  libtesseract.so. Adding an unversioned copy alongside it makes the process map
                  leptonica twice.

              The bytedeco jars also carry headers and .a files (~2 MB); the includes below drop them.

              This moved here from botmaker-shared/pom.xml in SDK 1.2.0, unchanged apart from living
              beside the code it serves. The staging half is the maven-antrun execution below.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.6.1</version>
                <executions>
                    <execution>
                        <id>unpack-linux-ocr-natives</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>unpack</goal>
                        </goals>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>org.bytedeco</groupId>
                                    <artifactId>tesseract</artifactId>
                                    <version>${bytedeco.tesseract.version}</version>
                                    <classifier>linux-x86_64</classifier>
                                    <includes>**/libtesseract.so.*</includes>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>org.bytedeco</groupId>
                                    <artifactId>leptonica</artifactId>
                                    <version>${bytedeco.leptonica.version}</version>
                                    <classifier>linux-x86_64</classifier>
                                    <includes>**/libleptonica.so.*</includes>
                                </artifactItem>
                            </artifactItems>
                            <outputDirectory>${project.build.directory}/native-stage</outputDirectory>
                            <overWriteReleases>false</overWriteReleases>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Antrun: TWO executions, unrelated to each other beyond sharing a plugin. `whats-new`
                 copies the changelog into the jar; `stage-linux-ocr-natives` finishes the OCR native
                 staging the dependency plugin above started. They are one <plugin> because Maven takes a
                 single declaration per plugin per pom, not because they belong together.

                 whats-new: put this module's CHANGELOG.md inside the jar, as
                 META-INF/botmaker/whats-new.md.

                 Studio's Project > Upgrade SDK... leads with what a release GIVES you, before it lists
                 what it costs. It reads that out of the target jar it has already downloaded to diff, so
                 the answer is offline and needs no GitHub API, no release notes and no network at all.

                 The WHOLE file, not the section being upgraded to: a bot may jump several releases at
                 once, so the jar has to be able to answer every span ending at its own version. A jar
                 built from a tree with no changelog simply has no entry, and Studio falls back to the API
                 diff it showed before — the standing rule that every new reader degrades.

                 A copy rather than <resource> on the module root: the root is not a resource directory
                 and making it one would sweep the pom, the LICENSE and .deps.env into the jar too. And
                 antrun rather than maven-resources-plugin because the file has to be RENAMED — the entry
                 name is a contract with Studio's reader and must not follow whatever the file is called
                 in the repo — which copy-resources cannot do (it has no fileMappers on that goal).

                 tolerant of a missing source: `failonerror=false` keeps a tree with no changelog building,
                 which is what a jar built from an older tag is. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>whats-new</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <copy file="${project.basedir}/CHANGELOG.md"
                                      tofile="${project.build.outputDirectory}/META-INF/botmaker/whats-new.md"
                                      failonerror="false" overwrite="true"/>
                            </target>
                        </configuration>
                    </execution>
                    <execution>
                        <id>stage-linux-ocr-natives</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <property name="ocr.natives.dir"
                                          value="${project.build.outputDirectory}/linux-x86-64"/>
                                <mkdir dir="${ocr.natives.dir}"/>
                                <!-- Flattened and renamed: see the filename note above. -->
                                <copy todir="${ocr.natives.dir}" flatten="true" failonerror="true">
                                    <fileset dir="${project.build.directory}/native-stage"
                                             includes="**/libtesseract.so.*"/>
                                    <mapper type="merge" to="libtesseract.so"/>
                                </copy>
                                <copy todir="${ocr.natives.dir}" flatten="true" failonerror="true">
                                    <fileset dir="${project.build.directory}/native-stage"
                                             includes="**/libleptonica.so.*"/>
                                </copy>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Jar Plugin: stamp the manifest with Implementation-* (pom version/vendor) and a Build-Time
                 so a running bot / Studio's editor can report exactly which SDK build was loaded. The pom
                 version is cosmetic (0.0.0-SNAPSHOT for local dev; JitPack overrides it with the tag), so
                 Build-Time is the signal that distinguishes local rebuilds sharing one jar file name. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <archive>
                        <manifest>
                            <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
                        </manifest>
                        <manifestEntries>
                            <Build-Time>${maven.build.timestamp}</Build-Time>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>

            <!-- Flatten Plugin: publish a pom whose ${...} are already resolved.

                 This is what makes the botmaker.shared.version / botmaker.session.version contract above
                 actually work. `mvn install -Dbotmaker.shared.version=v0.0.18` installs the COMMITTED pom
                 (still carrying the property at 0.0.0-SNAPSHOT), so the injected tag never reached a
                 consumer: a generated bot pinning a released SDK failed with "Could not find artifact
                 com.github.LiQiyeDev:botmaker-shared:jar:0.0.0-SNAPSHOT in jitpack.io" on any machine with
                 no local build in ~/.m2. Flatten substitutes the effective values into
                 target/.flattened-pom.xml and installs THAT, so the published pom names the real tag.

                 flattenMode=oss keeps dependencies/licenses/scm and drops build+profiles (neither is read
                 by a consumer here — this module has no profiles; do not copy this to botmaker-shared,
                 whose OS-activated native profiles a consumer DOES need). It also strips repositories,
                 hence the explicit keep: the jitpack.io repo declared above is how a consumer reaches the
                 transitive shared/session at all. The clean execution removes the generated file. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <!-- Held at 1.4.1 for JitPack, NOT stale: 1.5.0 declares a Maven 3.5.4 prerequisite and
                     1.6.0 declares 3.6.3, and JitPack's build image runs older than 3.6.3 — v0.0.7/v1.0.25
                     were burned finding that out ("requires Maven version 3.6.3", build failed before it
                     published anything). 1.4.1 needs only 3.2.5 and supports the same flattenMode and
                     pomElements config used here. Do not bump without proving JitPack's mvn version. -->
                <version>1.4.1</version>
                <configuration>
                    <flattenMode>oss</flattenMode>
                    <pomElements>
                        <repositories>keep</repositories>
                    </pomElements>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>flatten</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>flatten.clean</id>
                        <phase>clean</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Source Plugin: attaches source code so consumers get Javadoc/code in their IDE -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.3.0</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.jetbrains.dokka</groupId>
                <artifactId>dokka-maven-plugin</artifactId>
                <version>1.9.20</version> <!-- Latest stable 1.9.x version -->
                <executions>
                    <execution>
                        <phase>pre-site</phase>
                        <goals>
                            <goal>dokka</goal> <!-- 'dokka' generates the modern HTML UI -->
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <sourceDirectories>
                        <dir>${project.basedir}/src/main/java</dir>
                    </sourceDirectories>

                    <!-- Optional: Add a custom home page (like a Swagger overview) -->
                    <!--
                    <includes>
                        <include>${project.basedir}/README.md</include>
                    </includes>
                    -->
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
