<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.github.LiQiyeDev</groupId>
    <artifactId>botmaker-sdk</artifactId>
    <version>0.0.0-SNAPSHOT</version>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Stamped into the jar manifest (Build-Time) so a bot/editor can tell which SDK build it loaded;
             crucial for local dev where every rebuild reuses the same 0.0.0-SNAPSHOT jar file name. -->
        <maven.build.timestamp.format>yyyy-MM-dd'T'HH:mm:ss'Z'</maven.build.timestamp.format>
        <!-- botmaker-shared version. Committed value is ALWAYS 0.0.0-SNAPSHOT: it resolves the sibling
             module in the umbrella reactor / dev-install. The real released shared tag is injected only at
             build time by CI (jitpack.yml) via -Dbotmaker.shared.version=<tag> — never committed here, so a
             clean checkout matches the reactor/dev value and there is no stale pin to get out of sync.

             That injection only reaches CONSUMERS because of flatten-maven-plugin below. Maven installs and
             publishes the COMMITTED pom, not the effective one, so a -D on the command line changes what
             this build resolves and nothing about what a bot resolving this SDK from JitPack sees. Without
             flatten, the published pom still said botmaker-shared:${botmaker.shared.version} with the
             property at 0.0.0-SNAPSHOT, and every released SDK failed to resolve on any machine that had
             never built this repo locally. Do not remove the plugin without replacing the mechanism. -->
        <botmaker.shared.version>0.0.0-SNAPSHOT</botmaker.shared.version>
        <!-- botmaker-session version. Same contract as botmaker.shared.version above: always 0.0.0-SNAPSHOT
             in the committed pom, injected at build time by CI for a released tag, resolved into the
             published pom by flatten. -->
        <botmaker.session.version>0.0.0-SNAPSHOT</botmaker.session.version>

        <!-- The released tag the api-check profile compares this build against. Always injected from
             outside (CI computes the previous tag; release.sh passes the tag it is superseding) — there is
             no sensible committed default, and japicmp's own "latest released version" auto-detection is
             NOT usable here: it reads the repository's maven-metadata.xml, and JitPack's lists every SDK
             release twice (`v1.0.7` AND `1.0.7`; see botmaker-studio JitPackSearch.dedupeVPrefix, which
             exists solely to clean that up), so "latest" there is a coin flip. -->
        <botmaker.api.oldVersion>NONE</botmaker.api.oldVersion>
        <!-- Whether japicmp itself fails the build on an incompatible change. DEFAULT false, deliberately.
             "Is this break allowed?" is a question about the version number being released, and neither a
             PR build nor this pom knows that number — only release.sh does, so release.sh is the gate.
             Left true, CI would block every legitimate major-release PR.

             This does NOT make CI toothless: tools/check-api-rules.py enforces the two rules that hold
             at EVERY version — removing something never marked @Deprecated(forRemoval = true), and
             breaking something with no migration recipe or note — and ci.yml fails the build on either
             regardless of this flag. -->
        <botmaker.api.breakBuild>false</botmaker.api.breakBuild>
    </properties>

    <repositories>
        <!-- JitPack: resolves com.github.LiQiyeDev:botmaker-shared:<tag> when this SDK is built
             standalone against a released shared (the umbrella reactor resolves the SNAPSHOT locally
             instead, and JitPack's own build env injects this repo too). -->
        <repository>
            <id>jitpack.io</id>
            <url>https://jitpack.io</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- Shared cross-platform native window plumbing (enumerate / capture / focus / input).
             com.github.LiQiyeDev coordinate + version property so this resolves from the umbrella
             reactor locally and from JitPack when published (see the property comment above). -->
        <dependency>
            <groupId>com.github.LiQiyeDev</groupId>
            <artifactId>botmaker-shared</artifactId>
            <version>${botmaker.shared.version}</version>
        </dependency>

        <!-- Private display sessions (com.botmaker.session.*): the nested :N display a bot isolates into,
             reached from Target.start() via internal.session.SessionBootstrap. Same coordinate/property
             contract as shared above. It depends on shared itself, so this is additive, not a replacement. -->
        <dependency>
            <groupId>com.github.LiQiyeDev</groupId>
            <artifactId>botmaker-session</artifactId>
            <version>${botmaker.session.version}</version>
        </dependency>

        <!-- JavaCV / OpenCV (native bindings used for image matching) -->
        <dependency>
            <groupId>org.openpnp</groupId>
            <artifactId>opencv</artifactId>
            <version>4.9.0-0</version>
        </dependency>

        <!-- JNA (native Windows/Linux window + input control) -->
        <dependency>
            <groupId>net.java.dev.jna</groupId>
            <artifactId>jna</artifactId>
            <version>5.14.0</version>
        </dependency>
        <dependency>
            <groupId>net.java.dev.jna</groupId>
            <artifactId>jna-platform</artifactId>
            <version>5.14.0</version>
        </dependency>

        <!-- Jackson Databind (config serialization) -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.17.0</version>
        </dependency>

        <!-- The Android-emulator transport (dadb) lives in botmaker-shared now, so it arrives transitively
             via the shared dependency above — the SDK's api.emulator facade compiles against
             com.botmaker.shared.emulator.{AdbDevice, Platforms, EmulatorInstance}. -->

        <!-- Test Dependencies -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <version>1.10.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Maven Compiler Plugin -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <!-- Emit the MethodParameters attribute so real parameter names survive in the
                         bytecode. Studio (which does NOT depend on the SDK) reads them from the resolved
                         SDK jar via ClassGraph to label call arguments (e.g. findCompare(good, bad))
                         instead of arg0/arg1. -->
                    <parameters>true</parameters>
                </configuration>
            </plugin>

            <!-- Jar Plugin: stamp the manifest with Implementation-* (pom version/vendor) and a Build-Time
                 so a running bot / Studio's editor can report exactly which SDK build was loaded. The pom
                 version is cosmetic (0.0.0-SNAPSHOT for local dev; JitPack overrides it with the tag), so
                 Build-Time is the signal that distinguishes local rebuilds sharing one jar file name. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <archive>
                        <manifest>
                            <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
                        </manifest>
                        <manifestEntries>
                            <Build-Time>${maven.build.timestamp}</Build-Time>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>

            <!-- Flatten Plugin: publish a pom whose ${...} are already resolved.

                 This is what makes the botmaker.shared.version / botmaker.session.version contract above
                 actually work. `mvn install -Dbotmaker.shared.version=v0.0.18` installs the COMMITTED pom
                 (still carrying the property at 0.0.0-SNAPSHOT), so the injected tag never reached a
                 consumer: a generated bot pinning a released SDK failed with "Could not find artifact
                 com.github.LiQiyeDev:botmaker-shared:jar:0.0.0-SNAPSHOT in jitpack.io" on any machine with
                 no local build in ~/.m2. Flatten substitutes the effective values into
                 target/.flattened-pom.xml and installs THAT, so the published pom names the real tag.

                 flattenMode=oss keeps dependencies/licenses/scm and drops build+profiles (neither is read
                 by a consumer here — this module has no profiles; do not copy this to botmaker-shared,
                 whose OS-activated native profiles a consumer DOES need). It also strips repositories,
                 hence the explicit keep: the jitpack.io repo declared above is how a consumer reaches the
                 transitive shared/session at all. The clean execution removes the generated file. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <!-- Held at 1.4.1 for JitPack, NOT stale: 1.5.0 declares a Maven 3.5.4 prerequisite and
                     1.6.0 declares 3.6.3, and JitPack's build image runs older than 3.6.3 — v0.0.7/v1.0.25
                     were burned finding that out ("requires Maven version 3.6.3", build failed before it
                     published anything). 1.4.1 needs only 3.2.5 and supports the same flattenMode and
                     pomElements config used here. Do not bump without proving JitPack's mvn version. -->
                <version>1.4.1</version>
                <configuration>
                    <flattenMode>oss</flattenMode>
                    <pomElements>
                        <repositories>keep</repositories>
                    </pomElements>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>flatten</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>flatten.clean</id>
                        <phase>clean</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Source Plugin: attaches source code so consumers get Javadoc/code in their IDE -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.3.0</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.jetbrains.dokka</groupId>
                <artifactId>dokka-maven-plugin</artifactId>
                <version>1.9.20</version> <!-- Latest stable 1.9.x version -->
                <executions>
                    <execution>
                        <phase>pre-site</phase>
                        <goals>
                            <goal>dokka</goal> <!-- 'dokka' generates the modern HTML UI -->
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <sourceDirectories>
                        <dir>${project.basedir}/src/main/java</dir>
                    </sourceDirectories>

                    <!-- Optional: Add a custom home page (like a Swagger overview) -->
                    <!--
                    <includes>
                        <include>${project.basedir}/README.md</include>
                    </includes>
                    -->
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- The API compatibility gate. See ../docs/refactor/21-api-compat.md for the contract it enforces.
             Not active by default, deliberately: japicmp downloads the previously released jar, and
             `mvn -pl botmaker-sdk -am install` is the daily dev loop, which must stay offline and fast. It
             is switched on by this module's ci.yml (so a break fails the PR) and by the umbrella
             release.sh (so a break cannot be tagged).

             Note flattenMode=oss above DROPS <profiles> from the published pom. That is correct here — a
             bot resolving this SDK has no use for our build-time gate — and is the opposite of the
             situation in botmaker-shared, whose OS-activated native profiles a consumer genuinely needs.

             Why compare against the published jar at all: an annotation cannot record a removal. It lives
             ON the member, so deleting the member deletes the evidence. @Deprecated(forRemoval = true) is
             a promise about the future; "this used to exist" is a fact about the past, and only the
             previous artifact holds it. -->
        <profile>
            <id>api-check</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.github.siom79.japicmp</groupId>
                        <artifactId>japicmp-maven-plugin</artifactId>
                        <version>0.26.1</version>
                        <executions>
                            <execution>
                                <phase>verify</phase>
                                <goals>
                                    <goal>cmp</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <oldVersion>
                                <dependency>
                                    <groupId>com.github.LiQiyeDev</groupId>
                                    <artifactId>botmaker-sdk</artifactId>
                                    <version>${botmaker.api.oldVersion}</version>
                                    <type>jar</type>
                                </dependency>
                            </oldVersion>
                            <parameter>
                                <!-- The contract's scope is the api package only; internal.* is plumbing a
                                     bot never names, and stays freely changeable. -->
                                <includes>
                                    <include>com.botmaker.sdk.api</include>
                                </includes>
                                <!-- protected, not public: a bot can subclass and see protected members. -->
                                <accessModifier>protected</accessModifier>
                                <onlyModified>true</onlyModified>
                                <!-- The old jar's transitive OpenCV/JNA need not resolve for signatures to
                                     be compared, and demanding they do would make the gate fail for
                                     reasons that have nothing to do with our API. -->
                                <ignoreMissingClasses>true</ignoreMissingClasses>
                                <breakBuildOnBinaryIncompatibleModifications>${botmaker.api.breakBuild}</breakBuildOnBinaryIncompatibleModifications>
                                <breakBuildOnSourceIncompatibleModifications>${botmaker.api.breakBuild}</breakBuildOnSourceIncompatibleModifications>
                                <!-- Deliberately NOT breakBuildBasedOnSemanticVersioning: it derives the
                                     level from the two archives' version strings, and this pom's <version>
                                     is cosmetic 0.0.0-SNAPSHOT (JitPack owns the real one). Feeding it a
                                     fake version to satisfy the check would be worse than release.sh
                                     comparing the numbers itself, which it already does.

                                     Nor <postAnalysisScript>, which is the natural home for the
                                     deprecation-cycle rule: japicmp 0.26.1 bundles a Groovy that cannot
                                     read Java 26 class files ("Unsupported class file major version
                                     70"), and this project's JDK is 26 while CI runs 21. The rule lives
                                     in tools/check-api-rules.py instead, reading japicmp.xml — which is
                                     JDK-proof, and is run by both ci.yml and release.sh. -->
                            </parameter>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
